# M8 local-only runtime. Do not paste secrets into ChatGPT.
CFE_DATA_DIR=.data
CFE_LOCAL_PORT=18787
CFE_AUTO_POST_ENABLED=false
CFE_MAX_POSTS_PER_DAY=3
CFE_POST_SLOTS=07:30,12:30,19:30
CFE_SLOT_WINDOW_MINUTES=20
CFE_CATCH_UP=true

# External Reply Engine v1
CFE_EXTERNAL_REPLY_ENABLED=false
CFE_EXTERNAL_REPLY_MAX_PER_DAY=3
CFE_EXTERNAL_REPLY_MIN_SCORE=45

# Meta Threads official API (copy from current secure environment into this local file only)
THREADS_API_BASE=https://graph.threads.net/v1.0
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Rakuten official API
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
RAKUTEN_API_BASE=https://openapi.rakuten.co.jp/ichibams/api/IchibaItem/Search/20260701
RAKUTEN_KEYWORDS=キッチン 便利グッズ,収納 便利グッズ,家事 時短,掃除 便利グッズ,スマホ 便利グッズ

# M8 browser worker
THREADS_PROFILE_DIR=.data/threads-profile
THREADS_SCAN_INTERVAL_MINUTES=30
THREADS_HEADLESS=true
